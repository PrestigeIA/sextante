# Copy to .env.local and fill in. Nothing here is required for `npm run dev`:
# without it the app runs on an embedded PGLite database, and payments simply
# report "not configured".

# --- Database (Postgres / Neon). Unset -> local embedded PGLite (dev only). ---
DATABASE_URL=

# --- Auth (Better Auth) ---
# Random 32+ char string (e.g. `openssl rand -hex 32`). Required in production.
BETTER_AUTH_SECRET=
# Canonical public URL, e.g. https://www.sextante.app (no trailing slash).
BETTER_AUTH_URL=

# --- Stripe (web checkout) — one product "Sextante Pro", two recurring prices ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# --- RevenueCat (iOS / Android in-app purchase) ---
# Public SDK key (build-time). Entitlement id in the dashboard: sextante_pro
VITE_REVENUECAT_PUBLIC_API_KEY=
# Same string in RevenueCat → Integrations → Webhooks → Authorization header.
REVENUECAT_WEBHOOK_SECRET=

# --- Transactional email (password reset) via Resend ---
RESEND_API_KEY=
EMAIL_FROM="Sextante <no-reply@SEU-DOMINIO>"
# Show "Forgot password" only after email sending works (build-time).
VITE_PASSWORD_RESET_ENABLED=false

# --- Native shells: URL the iOS/Android apps load (read by capacitor.config.ts) ---
SEXTANTE_APP_URL=
